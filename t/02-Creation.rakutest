use v6.d;

use Test;
use Math::SparseMatrix;
use ML::LatentSemanticAnalyzer;
use ML::LatentSemanticAnalyzer::Utilities;

sub resource-documents() {
    my @abstracts = ML::LatentSemanticAnalyzer::Utilities::get-abstracts-dataset();
    @abstracts .= grep({ $_<ID> ~~ Str:D && $_<Abstract> ~~ Str:D && $_<Abstract>.chars > 0 });
    return (@abstracts.map(*<ID>) Z=> @abstracts.map(*<Abstract>)).Hash;
}

my %docs = resource-documents();

my $lsa1 = ML::LatentSemanticAnalyzer.new
        .make-document-term-matrix(docs => %docs, :stop-words, :stemming-rules, :3min-length)
        .apply-term-weight-functions(
                global-weight-func => 'IDF',
                local-weight-func => 'None',
                normalizer-func => 'Cosine'
        );

isa-ok $lsa1, ML::LatentSemanticAnalyzer, 'creates an LSA object from method documents';
isa-ok $lsa1.take-doc-term-mat, Math::SparseMatrix, 'method creation sets a document-term matrix';
isa-ok $lsa1.take-weighted-doc-term-mat, Math::SparseMatrix, 'method creation sets a weighted document-term matrix';
ok $lsa1.take-doc-term-mat.rows-count > 570, 'method-created matrix has the expected document count';
ok $lsa1.take-doc-term-mat.columns-count > 2000, 'method-created matrix has the expected term count';

my $lsa2 = ML::LatentSemanticAnalyzer.new(%docs)
        .make-document-term-matrix(:stop-words, :stemming-rules, :3min-length)
        .apply-term-weight-functions(
                global-weight-func => 'IDF',
                local-weight-func => 'None',
                normalizer-func => 'Cosine'
        );

isa-ok $lsa2, ML::LatentSemanticAnalyzer, 'creates an LSA object from constructor documents';
isa-ok $lsa2.take-doc-term-mat, Math::SparseMatrix, 'constructor creation sets a document-term matrix';
isa-ok $lsa2.take-weighted-doc-term-mat, Math::SparseMatrix, 'constructor creation sets a weighted document-term matrix';
ok $lsa2.take-doc-term-mat.rows-count > 570, 'constructor-created matrix has the expected document count';
ok $lsa2.take-doc-term-mat.columns-count > 2000, 'constructor-created matrix has the expected term count';

done-testing;
